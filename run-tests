#!/bin/sh
# Regression suite. Usage:
#   ./run-tests                 run everything
#   ./run-tests -k catch        run tests matching a pattern
#   ./run-tests -v              show notes and tracebacks
#   ./run-tests --build-fixtures [name...]
here=$(cd "$(dirname "$0")" && pwd)
if [ ! -x "$here/.venv/bin/python" ]; then
  echo "no venv found. Run: python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec "$here/.venv/bin/python" -m tests "$@"
